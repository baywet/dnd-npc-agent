<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ModelEval</RootNamespace>
    <AssemblyName>model-eval</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.Projects" Version="2.1.0-beta.3" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\model-finetuning\data\dnd_npc_data_test.jsonl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>datasets\dnd_npc_data_test.jsonl</Link>
    </Content>
  </ItemGroup>

</Project>
