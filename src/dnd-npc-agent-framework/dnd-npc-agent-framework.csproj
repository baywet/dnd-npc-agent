<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DnDNpcAgent</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>c424a5a6-d352-4deb-90b3-797d32de38b5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Agent Framework hosting — provides AgentHost, AddFoundryResponses, MapFoundryResponses -->
    <PackageReference Include="Azure.Core" Version="1.64.0" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.23.0-preview.260928.1" />
    <!-- Foundry SDK — provides AIProjectClient and AsAIAgent -->
    <PackageReference Include="Azure.AI.Projects" Version="3.0.0-beta.3" />
    <!-- .env file support for local development -->
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Skills\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
