<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AgentEvals</RootNamespace>
    <AssemblyName>agent-evals</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.Projects" Version="2.1.0-beta.1" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\agent-eval-datasets\character_sheet_requirement.jsonl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>datasets\character_sheet_requirement.jsonl</Link>
    </Content>
  </ItemGroup>

</Project>
